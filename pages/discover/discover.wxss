/* discover.wxss */
.container {
  padding: 30rpx;
}

/* 标题样式 */
.section-header {
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.section-subtitle {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-top: 6rpx;
}

/* 摄影百科样式 */
.wiki-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 60rpx;
}

.wiki-item {
  display: flex;
  align-items: center;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.wiki-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 30rpx;
}

.wiki-info {
  flex: 1;
}

.wiki-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.wiki-desc {
  font-size: 26rpx;
  color: #666;
}

.arrow-right {
  width: 16rpx;
  height: 16rpx;
  border-top: 4rpx solid #ccc;
  border-right: 4rpx solid #ccc;
  transform: rotate(45deg);
}

/* 教程专栏样式 */
.course-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom: 60rpx;
}

.course-item {
  background-color: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.course-image {
  width: 100%;
  height: 240rpx;
}

.course-info {
  padding: 20rpx;
}

.course-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.course-desc {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.course-progress-container {
  height: 10rpx;
  background-color: #f0f0f0;
  border-radius: 10rpx;
  position: relative;
  overflow: hidden;
}

.course-progress-bar {
  height: 100%;
  background-color: #1296db;
  border-radius: 10rpx;
}

.course-progress-text {
  position: absolute;
  right: 0;
  top: -26rpx;
  font-size: 24rpx;
  color: #1296db;
}

/* 互动社区样式 */
.community-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.community-item {
  position: relative;
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.community-image {
  width: 100%;
  height: 100%;
}

.community-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.7));
}

.community-info {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 30rpx;
  color: #fff;
}

.community-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.community-desc {
  font-size: 26rpx;
  opacity: 0.9;
  margin-bottom: 16rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.5);
}

.community-participants {
  display: flex;
  align-items: center;
}

.participants-count {
  font-size: 28rpx;
  font-weight: bold;
  margin-right: 6rpx;
}

.participants-label {
  font-size: 24rpx;
  opacity: 0.9;
} 