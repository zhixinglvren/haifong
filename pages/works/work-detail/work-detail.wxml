<!--work-detail.wxml-->
<view class="container">
  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{isLoading}}">
    <view class="loading"></view>
  </view>
  
  <!-- 作品详情 -->
  <block wx:else>
    <!-- 图片展示区 -->
    <view class="work-image-section">
      <image src="{{work.imageUrl}}" mode="widthFix" class="work-image"></image>
      
      <!-- 作品信息浮层 -->
      <view class="work-title-overlay">
        <view class="work-title">{{work.title}}</view>
        <view class="work-photographer">by {{work.photographer}}</view>
      </view>
    </view>
    
    <!-- 操作按钮区 -->
    <view class="action-bar">
      <view class="action-item {{isLiked ? 'active' : ''}}" bindtap="handleLike">
        <view class="action-icon-wrapper">
          <view class="action-icon like-icon"></view>
        </view>
        <text class="action-text">{{work.likes}}</text>
      </view>
      
      <view class="action-item {{isCollected ? 'active' : ''}}" bindtap="handleCollect">
        <view class="action-icon-wrapper">
          <view class="action-icon collect-icon"></view>
        </view>
        <text class="action-text">{{work.collections}}</text>
      </view>
      
      <view class="action-item" bindtap="handleComment">
        <view class="action-icon-wrapper">
          <view class="action-icon comment-icon"></view>
        </view>
        <text class="action-text">{{work.comments}}</text>
      </view>
      
      <button class="action-item share-btn" open-type="share" bindtap="handleShare">
        <view class="action-icon-wrapper">
          <view class="action-icon share-icon"></view>
        </view>
        <text class="action-text">分享</text>
      </button>
    </view>
    
    <!-- 下载按钮 -->
    <view class="download-btn" bindtap="handleDownload">
      <text class="download-text">保存为壁纸</text>
    </view>
    
    <!-- 作品描述 -->
    <view class="work-info-section">
      <view class="section-title">作品描述</view>
      <view class="work-description">{{work.description}}</view>
    </view>
    
    <!-- 拍摄信息 -->
    <view class="work-info-section">
      <view class="section-title">拍摄信息</view>
      <view class="info-list">
        <view class="info-item">
          <text class="info-label">拍摄时间：</text>
          <text class="info-value">{{work.date}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">拍摄地点：</text>
          <text class="info-value">{{work.location}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">所属主题：</text>
          <text class="info-value">{{work.theme}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">相机：</text>
          <text class="info-value">{{work.camera}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">镜头：</text>
          <text class="info-value">{{work.lens}}</text>
        </view>
        <view class="info-item">
          <text class="info-label">参数：</text>
          <text class="info-value">{{work.settings}}</text>
        </view>
      </view>
    </view>
  </block>
  
  <!-- 水印Canvas组件 -->
  <canvas canvas-id="watermarkCanvas" style="position: absolute; left: -9999px; top: -9999px;"></canvas>
</view> 